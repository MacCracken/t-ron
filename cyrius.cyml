[package]
name = "t-ron"
version = "${file:VERSION}"
description = "MCP security monitor — tool call auditing, rate limiting, injection detection, anomaly analysis"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.6"
repository = "https://github.com/MacCracken/t-ron"

[build]
entry = "src/main.cyr"
output = "build/t-ron"

# Modules `cyrius distlib` bundles into dist/t-ron.cyr, the single file
# consumers vendor (see DEPS-PATTERN.md). Order matches the include order in
# src/main.cyr: cyrius is single-pass, so a module must follow everything it
# references. Every src/ file main.cyr includes must be listed; CI checks.
# Kept under [lib], not [build], so tests and benches include only the
# modules they need.
[lib]
modules = [
    "src/error.cyr",
    "src/gate.cyr",
    "src/policy.cyr",
    "src/rate.cyr",
    "src/scanner.cyr",
    "src/pattern.cyr",
    "src/audit.cyr",
    "src/score.cyr",
    "src/query.cyr",
    "src/correlation.cyr",
    "src/tron.cyr",
    "src/tools.cyr",
    "src/middleware.cyr",
    "src/llm_scan.cyr",
    "src/signing.cyr",
    "src/signal.cyr",
    "src/crypto_chacha20.cyr",
    "src/safety.cyr",
]

# Stdlib modules `cyrius deps` vendors into lib/ from the pinned snapshot and
# `cyrius build` prepends to the compile unit, in this order. Several are
# here for the deps below rather than for src/ (bayan, fs, process, sync);
# the include-order constraints are documented at the includes in
# src/main.cyr.
#
# No comments inside the array: the parser takes any double-quoted token in
# the array region as a module name, even one inside a comment.
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "slice",
    "syscalls",
    "io",
    "args",
    "tagged",
    "assert",
    "fnptr",
    "hashmap",
    "regex",
    "chrono",
    "freelist",
    "sakshi",
    "fs",
    "process",
    "bayan",
    "net",
    "atomic",
    "sync",
    "thread",
    "thread_local",
    "ct",
    "keccak",
    "random",
]

# Two rules for the git deps below.
#
# 1. The section name must equal the module's basename: dist/bote-core.cyr
#    belongs under deps.bote-core, not deps.bote. `cyrius distlib` leaves a
#    bundled dep out of dist/t-ron.deps only on that match; on a mismatch it
#    emits the basename as a stdlib leaf, and every consumer's `cyrius deps`
#    then fails with "dep t-ron requires '<name>' but it is not in the cyrius
#    stdlib". CI's "Dist sidecar validity gate" checks each leaf against the
#    toolchain stdlib.
#
# 2. `path` beats `tag` whenever the sibling checkout exists, and skips
#    commit-pin verification: a local build compiles the sibling's working
#    tree while CI clones the tag. Before a release, resolve and build from a
#    sibling-free copy (`git archive HEAD` into an empty directory).

# libro audit chain, as its single-file dist bundle rather than per-module
# src/ pulls: libro's #derive(accessors) getters only exist when its modules
# are preprocessed together in dist order.
[deps.libro]
git = "https://github.com/MacCracken/libro"
path = "../libro"
tag = "2.10.3"
modules = ["dist/libro.cyr"]

# bote MCP core, transport-free profile (`cyrius distlib core` in bote).
# t-ron wraps bote's Dispatcher and never wires a transport, so it does not
# take the full dist/bote.cyr. majra arrives through bote's own deps.majra.
[deps.bote-core]
git = "https://github.com/MacCracken/bote"
path = "../bote"
tag = "3.3.13"
modules = ["dist/bote-core.cyr"]

# sigil, as the full dist/sigil.cyr bundle. libro's own deps.sigil lists only
# thin sub-bundles (sigil-mldsa, sha256, sha_ni, hex); this section overrides
# it, so exactly one sigil is compiled. Without it the sub-bundles land
# beside the stdlib copy and collide as duplicate definitions. Only the full
# bundle carries verify_data(), which src/signing.cyr calls.
#
# Keep the tag on the sigil release the pinned cyrius folds into its stdlib
# (the `# Version:` line of lib/sigil.cyr in the toolchain snapshot), so both
# copies are the same bytes.
[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
path = "../sigil"
tag = "3.12.18"
modules = ["dist/sigil.cyr"]
