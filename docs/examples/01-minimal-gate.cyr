#  docs/examples/01-minimal-gate.cyr
#
#  Smallest usable t-ron pipeline: build a TRon, load a policy for
#  one agent, run one allow check and one deny check.
#
#  cyrius build docs/examples/01-minimal-gate.cyr build/ex01 && ./build/ex01

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/slice.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/args.cyr"
include "lib/tagged.cyr"
include "lib/assert.cyr"
include "lib/fnptr.cyr"
include "lib/hashmap.cyr"
include "lib/regex.cyr"
include "lib/chrono.cyr"
include "lib/freelist.cyr"
include "lib/sakshi.cyr"
# bayan: json / base64 / bigint; libro's canonical JSON uses it.
include "lib/bayan.cyr"
include "lib/net.cyr"
# atomic / thread / thread_local and ct / keccak / random before sigil: its
# hash path takes a per-thread scratch bank, and its ML-DSA surface calls
# ct / keccak / random. Cyrius is single-pass; without them libro's
# chain_append traps with SIGILL at run time.
include "lib/atomic.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "lib/ct.cyr"
include "lib/keccak.cyr"
include "lib/random.cyr"
# process before sigil: its agnosys helpers call exec_capture.
include "lib/process.cyr"
include "lib/sigil.cyr"

include "lib/libro.cyr"

include "src/error.cyr"
include "src/json_text.cyr"
include "src/gate.cyr"
include "src/policy.cyr"
include "src/rate.cyr"
include "src/scanner.cyr"
include "src/pattern.cyr"
include "src/audit.cyr"
include "src/score.cyr"
include "src/query.cyr"
include "src/correlation.cyr"
include "src/tron.cyr"
include "src/crypto_chacha20.cyr"

fn main() {
    alloc_init();

    var tron = tron_new(tron_config_default());
    tron_load_policy(tron,
        "[agent.\"web-agent\"]\nallow = [\"tarang_*\"]\n");

    #  Allow path
    var ok = tron_check(tron, tool_call_new(
        "web-agent", "tarang_probe", "{}", clock_epoch_ns()));
    if (verdict_is_allowed(ok) == 0) {
        println("FAIL: expected allow");
        return 1;
    }
    println("OK: web-agent tarang_probe -> allow");

    #  Deny path (unknown agent with default-deny config)
    var deny = tron_check(tron, tool_call_new(
        "nobody", "tarang_probe", "{}", clock_epoch_ns()));
    if (verdict_is_denied(deny) == 0) {
        println("FAIL: expected deny");
        return 1;
    }
    println("OK: unknown agent -> deny");

    println("ex01 passed.");
    return 0;
}

var r = main();
sys_exit(r);
