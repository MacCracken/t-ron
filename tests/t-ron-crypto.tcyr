# t-ron crypto + signal + audit-export test suite
#
# This file is separate from tests/t-ron.tcyr because the combined
# content exceeds a Cyrius compile-state threshold; splitting gives
# each suite its own fresh parser context.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/slice.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/tagged.cyr"
include "lib/assert.cyr"
include "lib/fnptr.cyr"
include "lib/hashmap.cyr"
include "lib/regex.cyr"
include "lib/chrono.cyr"
include "lib/freelist.cyr"
include "lib/sakshi.cyr"
# bayan — consolidated json/base64/bigint stdlib bundle (cyrius 6.1.25
# carve; standalone modules retired from the 6.1.35+ snapshot). (2.1.6)
include "lib/bayan.cyr"
include "lib/net.cyr"
# atomic/thread/thread_local before sigil — sigil 3.7.14's serial hash
# path self-installs a TLS scratch bank (thread_local_get) and its
# parallel batch verify spawns thread workers; missing these, libro's
# chain_append SHA-256 SIGILLs at first crypto use. (2.1.5; reaffirmed 2.1.6)
include "lib/atomic.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"
# ct/keccak/random before sigil — sigil 3.7.14 ML-DSA + AES-GCM
# reference ct_eq_bytes_lens / _keccak_* / random_bytes; cyrius is single-pass.
include "lib/ct.cyr"
include "lib/keccak.cyr"
include "lib/random.cyr"
include "lib/sigil.cyr"

include "lib/libro.cyr"

include "src/error.cyr"
include "src/json_text.cyr"
include "src/gate.cyr"
include "src/policy.cyr"
include "src/rate.cyr"
include "src/scanner.cyr"
include "src/pattern.cyr"
include "src/audit.cyr"
include "src/score.cyr"
include "src/query.cyr"
include "src/correlation.cyr"
include "src/tron.cyr"
include "src/signing.cyr"
include "src/signal.cyr"
include "src/crypto_chacha20.cyr"

fn _write_file(path, buf, len) { return file_write_all(path, buf, len); }

fn _mk_audit_call(agent, tool) {
    return tool_call_new(agent, tool, "{}", 0);
}

fn _mk_deny() { return verdict_deny("nope", DENY_UNAUTHORIZED); }
fn _mk_flag() { return verdict_flag("sus"); }

# ============================================================
# tron_load_policy_file + tron_reload_policy
# ============================================================

fn test_tron_load_policy_file() {
    test_group("tron: load policy from file path");
    var path = "/tmp/_tron_loadfile.toml";
    var content = "[agent.\"filer\"]\nallow = [\"tarang_*\"]\n";
    _write_file(path, content, strlen(content));
    var t = tron_new(tron_config_default());
    assert_eq(tron_load_policy_file(t, path), TRON_ERR_NONE, "load ok");
    assert_eq(streq(tron_policy_path(t), path), 1, "path stored");
    var k, r = policy_check(tron_policy(t), "filer", "tarang_probe");
    assert_eq(k, PR_ALLOW, "policy active");
    return 0;
}

fn test_tron_reload_policy_noop() {
    test_group("tron: reload without stored path errors");
    var t = tron_new(tron_config_default());
    assert_eq(tron_reload_policy(t), TRON_ERR_POLICY, "no path -> policy err");
    return 0;
}

fn test_tron_reload_policy_picks_up_changes() {
    test_group("tron: reload picks up file changes");
    var path = "/tmp/_tron_reload.toml";
    _write_file(path, "[agent.\"webA\"]\nallow = [\"tarang_*\"]\n",
                strlen("[agent.\"webA\"]\nallow = [\"tarang_*\"]\n"));
    var t = tron_new(tron_config_default());
    assert_eq(tron_load_policy_file(t, path), TRON_ERR_NONE, "initial load");
    var k1, r1 = policy_check(tron_policy(t), "webA", "tarang_probe");
    assert_eq(k1, PR_ALLOW, "v1 allow");

    var updated = "[agent.\"webB\"]\nallow = [\"rasa_*\"]\n";
    _write_file(path, updated, strlen(updated));
    assert_eq(tron_reload_policy(t), TRON_ERR_NONE, "reload ok");
    var k2, r2 = policy_check(tron_policy(t), "webA", "tarang_probe");
    assert_eq(k2, PR_UNKNOWN_AGENT, "old agent gone after reload");
    var k3, r3 = policy_check(tron_policy(t), "webB", "rasa_edit");
    assert_eq(k3, PR_ALLOW, "new agent active");
    return 0;
}

# ============================================================
# SIGHUP hot-reload via signalfd
# ============================================================

fn test_sighup_init_returns_fd() {
    test_group("signal: sighup_init returns usable non-blocking fd");
    var fd = sighup_init();
    assert_eq((fd >= 0), 1, "fd returned");
    var t = tron_new(tron_config_default());
    assert_eq(sighup_drain_and_reload(fd, t), TRON_ERR_NONE, "empty drain ok");
    sighup_close(fd);
    return 0;
}

fn test_sighup_triggers_reload() {
    test_group("signal: delivered SIGHUP triggers reload");
    var path = "/tmp/_tron_sighup.toml";
    var original = "[agent.\"pre\"]\nallow = [\"*\"]\n";
    _write_file(path, original, strlen(original));
    var t = tron_new(tron_config_default());
    assert_eq(tron_load_policy_file(t, path), TRON_ERR_NONE, "initial load");

    var fd = sighup_init();
    assert_eq((fd >= 0), 1, "fd ok");

    var updated = "[agent.\"post\"]\nallow = [\"*\"]\n";
    _write_file(path, updated, strlen(updated));
    sys_kill(sys_getpid(), SIGHUP);                # signal ourselves

    assert_eq(sighup_drain_and_reload(fd, t), TRON_ERR_NONE, "drain+reload ok");
    var k, r = policy_check(tron_policy(t), "post", "any");
    assert_eq(k, PR_ALLOW, "reloaded policy active");
    var k2, r2 = policy_check(tron_policy(t), "pre", "any");
    assert_eq(k2, PR_UNKNOWN_AGENT, "old agent gone");
    sighup_close(fd);
    return 0;
}

# ============================================================
# ChaCha20  --  RFC 7539 section 2.4.2 test vector
# ============================================================

fn _cc_fill_key(buf) {
    var i = 0;
    while (i < 32) { store8(buf + i, i); i = i + 1; }
    return 0;
}

fn _cc_fill_nonce(buf) {
    store8(buf +  0, 0);  store8(buf +  1, 0);
    store8(buf +  2, 0);  store8(buf +  3, 0);
    store8(buf +  4, 0);  store8(buf +  5, 0);
    store8(buf +  6, 0);  store8(buf +  7, 0x4a);
    store8(buf +  8, 0);  store8(buf +  9, 0);
    store8(buf + 10, 0);  store8(buf + 11, 0);
    return 0;
}

fn test_chacha20_rfc_vector() {
    test_group("chacha20: RFC 7539 test vector");
    var key = alloc(32);
    _cc_fill_key(key);
    var nonce = alloc(12);
    _cc_fill_nonce(nonce);
    var plaintext = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
    var plen = strlen(plaintext);
    var ct = alloc(plen);
    cc20_xor(key, nonce, 1, plaintext, plen, ct);

    assert_eq(load8(ct + 0) & 0xFF, 0x6e, "ct[0] = 6e");
    assert_eq(load8(ct + 1) & 0xFF, 0x2e, "ct[1] = 2e");
    assert_eq(load8(ct + 2) & 0xFF, 0x35, "ct[2] = 35");
    assert_eq(load8(ct + 3) & 0xFF, 0x9a, "ct[3] = 9a");
    assert_eq(load8(ct + 4) & 0xFF, 0x25, "ct[4] = 25");
    assert_eq(load8(ct + 5) & 0xFF, 0x68, "ct[5] = 68");

    var pt2 = alloc(plen + 1);
    cc20_xor(key, nonce, 1, ct, plen, pt2);
    store8(pt2 + plen, 0);
    assert_eq(memeq(pt2, plaintext, plen), 1, "roundtrip plaintext");
    return 0;
}

# ============================================================
# Audit export  --  plain JSON + ChaCha20+Ed25519 AEAD
# ============================================================

fn test_audit_export_json_shape() {
    test_group("audit: export_json shape");
    var a = audit_logger_new();
    var c = _mk_audit_call("agent-1", "tarang_probe");
    audit_log(a, c, verdict_allow());
    audit_log(a, c, _mk_deny());
    var json = audit_export_json(a);
    var n = strlen(json);
    assert_eq(load8(json)     & 0xFF, 0x5b, "starts with [");
    assert_eq(load8(json + n - 1) & 0xFF, 0x5d, "ends with ]");
    return 0;
}

fn test_audit_export_encrypted_roundtrip() {
    test_group("audit: encrypted export roundtrip");
    var a = audit_logger_new();
    var c = _mk_audit_call("secret-agent", "tarang_probe");
    audit_log(a, c, verdict_allow());
    audit_log(a, c, verdict_flag("sus"));

    var sk = alloc(64);
    var pk = alloc(32);
    ed25519_generate_keypair(sk, pk);

    var key = alloc(32);
    var i = 0;
    while (i < 32) { store8(key + i, 0x20 + i); i = i + 1; }
    var nonce = alloc(12);
    var j = 0;
    while (j < 12) { store8(nonce + j, 0x80 + j); j = j + 1; }

    var out_len_slot = alloc(8);
    var cipher = audit_export_encrypted(a, nonce, key, sk, out_len_slot);
    var cipher_len = load64(out_len_slot);
    assert_eq((cipher_len > 76), 1, "envelope has ciphertext");

    var plain = audit_decrypt_export(cipher, cipher_len, key, pk);
    assert_eq((plain != 0), 1, "decrypt ok");

    var expected = audit_export_json(a);
    assert_eq(streq(plain, expected), 1, "plaintext matches export_json");
    return 0;
}

fn test_audit_decrypt_rejects_tamper() {
    test_group("audit: decrypt rejects tampered envelope");
    var a = audit_logger_new();
    audit_log(a, _mk_audit_call("x", "y"), verdict_allow());
    var sk = alloc(64);
    var pk = alloc(32);
    ed25519_generate_keypair(sk, pk);
    var key = alloc(32); memset(key, 0x11, 32);
    var nonce = alloc(12); memset(nonce, 0x22, 12);
    var out_len_slot = alloc(8);
    var cipher = audit_export_encrypted(a, nonce, key, sk, out_len_slot);
    var clen = load64(out_len_slot);

    store8(cipher + 80, (load8(cipher + 80) & 0xFF) ^ 0xFF);
    assert_eq(audit_decrypt_export(cipher, clen, key, pk), 0, "tampered rejected");
    return 0;
}

fn test_audit_decrypt_rejects_wrong_key() {
    test_group("audit: decrypt rejects wrong signing key");
    var a = audit_logger_new();
    audit_log(a, _mk_audit_call("x", "y"), verdict_allow());
    var sk1 = alloc(64); var pk1 = alloc(32);
    var sk2 = alloc(64); var pk2 = alloc(32);
    ed25519_generate_keypair(sk1, pk1);
    ed25519_generate_keypair(sk2, pk2);
    var key = alloc(32); memset(key, 0x33, 32);
    var nonce = alloc(12); memset(nonce, 0x44, 12);
    var out_len_slot = alloc(8);
    var cipher = audit_export_encrypted(a, nonce, key, sk1, out_len_slot);
    var clen = load64(out_len_slot);
    assert_eq(audit_decrypt_export(cipher, clen, key, pk2), 0, "wrong-key rejected");
    return 0;
}

#  ---- 2.2.3 regressions ------------------------------------------------

fn _t_has(hay, needle) {
    var hn = strlen(hay);
    var nn = strlen(needle);
    var i = 0;
    while (i + nn <= hn) {
        if (memeq(hay + i, needle, nn) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

#  Sign `content` with sk into path + path.sig.
fn _t_write_signed(path, sig_path, content, sk) {
    var sig = alloc(64);
    ed25519_sign(sk, content, strlen(content), sig);
    _write_file(path, content, strlen(content));
    _write_file(sig_path, sig, 64);
    return 0;
}

fn test_signed_reload_reverifies() {
    test_group("signing: SIGHUP reload of a signed policy re-verifies it");
    var sk = alloc(64);
    var pk = alloc(32);
    ed25519_generate_keypair(sk, pk);
    var path = "/tmp/tron_signed_reload.toml";
    _t_write_signed(path, "/tmp/tron_signed_reload.toml.sig",
        "[agent.\"trusted\"]\nallow = [\"tarang_*\"]\n", sk);
    var verifier = policy_verifier_new();
    policy_verifier_add_key(verifier, pk);
    var t = tron_new(tron_config_default());
    assert_eq(tron_verify_and_load_policy(t, verifier, path), TRON_ERR_NONE, "signed load");
    assert_eq(tron_policy_signed(t), 1, "signed mode on");

    #  Overwrite the policy without re-signing it, then reload.
    var evil = "[agent.\"evil\"]\nallow = [\"*\"]\n";
    _write_file(path, evil, strlen(evil));
    assert_eq(tron_reload_policy(t), TRON_ERR_SIGNATURE, "tampered file refused on reload");
    var k1, r1 = policy_check(tron_policy(t), "evil", "anything");
    assert_eq(k1, PR_UNKNOWN_AGENT, "tampered policy not installed");
    var k2, r2 = policy_check(tron_policy(t), "trusted", "tarang_probe");
    assert_eq(k2, PR_ALLOW, "signed policy still active");

    #  A properly re-signed file reloads.
    _t_write_signed(path, "/tmp/tron_signed_reload.toml.sig",
        "[agent.\"trusted2\"]\nallow = [\"*\"]\n", sk);
    assert_eq(tron_reload_policy(t), TRON_ERR_NONE, "re-signed file reloads");
    var k3, r3 = policy_check(tron_policy(t), "trusted2", "x");
    assert_eq(k3, PR_ALLOW, "re-signed policy active");
    return 0;
}

fn test_signed_mode_refuses_unsigned_loads() {
    test_group("signing: signed mode refuses unsigned loads");
    var sk = alloc(64);
    var pk = alloc(32);
    ed25519_generate_keypair(sk, pk);
    _t_write_signed("/tmp/tron_signed_mode.toml", "/tmp/tron_signed_mode.toml.sig",
        "[agent.\"a\"]\nallow = [\"x\"]\n", sk);
    var verifier = policy_verifier_new();
    policy_verifier_add_key(verifier, pk);
    var t = tron_new(tron_config_default());
    tron_verify_and_load_policy(t, verifier, "/tmp/tron_signed_mode.toml");
    assert_eq(tron_load_policy(t, "[agent.\"b\"]\nallow = [\"*\"]\n"), TRON_ERR_SIGNATURE, "tron_load_policy refused");
    _write_file("/tmp/tron_unsigned.toml", "[agent.\"b\"]\nallow = [\"*\"]\n", 28);
    assert_eq(tron_load_policy_file(t, "/tmp/tron_unsigned.toml"), TRON_ERR_SIGNATURE, "tron_load_policy_file refused");
    var k, r = policy_check(tron_policy(t), "b", "y");
    assert_eq(k, PR_UNKNOWN_AGENT, "unsigned policy not installed");
    return 0;
}

fn test_signing_overlong_sig_rejected() {
    test_group("signing: a .sig longer than 64 bytes is rejected");
    var sk = alloc(64);
    var pk = alloc(32);
    ed25519_generate_keypair(sk, pk);
    var content = "[agent.\"a\"]\nallow = [\"x\"]\n";
    var sig = alloc(100);
    memset(sig, 65, 100);
    ed25519_sign(sk, content, strlen(content), sig);
    _write_file("/tmp/tron_longsig.toml", content, strlen(content));
    _write_file("/tmp/tron_longsig.toml.sig", sig, 100);
    var verifier = policy_verifier_new();
    policy_verifier_add_key(verifier, pk);
    var t = tron_new(tron_config_default());
    assert_eq(tron_verify_and_load_policy(t, verifier, "/tmp/tron_longsig.toml"), TRON_ERR_SIGNATURE, "100-byte .sig refused");
    return 0;
}

fn _t_keys(sk, pk, key) {
    ed25519_generate_keypair(sk, pk);
    var i = 0;
    while (i < 32) { store8(key + i, 0x20 + i); i = i + 1; }
    return 0;
}

fn test_export_draws_its_own_nonce() {
    test_group("audit: nonce 0 draws a fresh random nonce");
    var a = audit_logger_new();
    audit_log(a, _mk_audit_call("agent-1", "tarang_probe"), verdict_allow());
    var sk = alloc(64); var pk = alloc(32); var key = alloc(32);
    _t_keys(sk, pk, key);
    var l1 = alloc(8); var l2 = alloc(8);
    var e1 = audit_export_encrypted(a, 0, key, sk, l1);
    var e2 = audit_export_encrypted(a, 0, key, sk, l2);
    assert_eq((e1 != 0 && e2 != 0), 1, "both exports built");
    assert_eq(memeq(e1, e2, 12), 0, "two exports, two nonces");
    var plain = audit_decrypt_export(e1, load64(l1), key, pk);
    assert_eq((plain != 0), 1, "decrypts");
    assert_eq(streq(plain, audit_export_json(a)), 1, "plaintext intact");
    return 0;
}

fn test_export_fails_on_bad_signing_key() {
    test_group("audit: a signing failure fails the export");
    var a = audit_logger_new();
    audit_log(a, _mk_audit_call("agent-1", "tarang_probe"), verdict_allow());
    var sk = alloc(64); var pk = alloc(32); var key = alloc(32);
    _t_keys(sk, pk, key);
    store8(sk + 40, (load8(sk + 40) ^ 1) & 0xFF);       #  public half no longer matches the seed
    var nonce = alloc(12);
    memset(nonce, 7, 12);
    var len = alloc(8);
    assert_eq(audit_export_encrypted(a, nonce, key, sk, len), 0, "export refused");
    assert_eq(load64(len), 0, "length 0");
    return 0;
}

fn test_export_escapes_and_sizes() {
    test_group("audit: export escapes values and sizes its buffer");
    var a = audit_logger_new();
    audit_log(a, _mk_audit_call("agent-1", "x\",\"verdict\":\"allow\",\"z\":\""), _mk_deny());
    var json = audit_export_json(a);
    assert_eq(_t_has(json, "\"tool_name\":\"x\\\",\\\"verdict\\\":\\\"allow\\\",\\\"z\\\":\\\"\""), 1, "quotes escaped");
    assert_eq(_t_has(json, "\"verdict\":\"deny\""), 1, "real verdict present");

    #  2 KB of quotes in both names: 4 KB escaped each, plus a reason that
    #  echoes neither (the old buffer was events * 512 + 32).
    var n = 2048;
    var big = alloc(n + 1);
    memset(big, 34, n);
    store8(big + n, 0);
    var b = audit_logger_new();
    audit_log(b, _mk_audit_call(big, big), verdict_deny(big, DENY_UNAUTHORIZED));
    var bj = audit_export_json(b);
    assert_eq((strlen(bj) > 3 * 2 * n), 1, "all three 2 KB fields written");
    assert_eq(load8(bj + strlen(bj) - 1) & 0xFF, 0x5d, "ends with ]");
    assert_eq(audit_verify_chain(b), 0, "libro chain intact after long details");
    return 0;
}

fn test_audit_details_long_names() {
    test_group("audit: libro details sized for reasons that echo names");
    #  A known agent calling a 250-byte unknown tool: the reason repeats the
    #  tool and agent names (the old details buffer was tool + 256 bytes).
    var t = tron_new(tron_config_default());
    tron_load_policy(t, "[agent.\"a\"]\nallow = [\"x\"]\n");
    var tool = alloc(251);
    memset(tool, 116, 250);
    store8(tool + 250, 0);
    var v = tron_check(t, tool_call_new("a", tool, "{}", 1700000000000000000));
    assert_eq(verdict_kind(v), VK_DENY, "unknown tool denied");
    assert_eq(audit_verify_chain(tron_audit(t)), 0, "chain verifies");
    #  The recorded details hold the whole reason, uncorrupted.
    var path = "/tmp/tron_details_chain.json";
    assert_eq(chain_export(audit_chain(tron_audit(t)), str_from(path)), 0, "chain exported");
    var buf = alloc(65536);
    var nread = file_read_all(path, buf, 65535);
    store8(buf + nread, 0);
    assert_eq(_t_has(buf, verdict_reason(v)), 1, "reason recorded verbatim");
    return 0;
}

fn test_chacha20_counter_guard() {
    test_group("chacha20: refuses a length that wraps the block counter");
    var key = alloc(32); var nonce = alloc(12);
    memset(key, 1, 32); memset(nonce, 2, 12);
    var data = alloc(128); var out = alloc(128);
    memset(data, 0, 128);
    assert_eq(cc20_xor(key, nonce, 4294967295, data, 128, out), 0 - 1, "2 blocks from 2^32-1 refused");
    assert_eq(cc20_xor(key, nonce, 4294967295, data, 64, out), 0, "1 block from 2^32-1 allowed");
    assert_eq(cc20_xor(key, nonce, 0 - 1, data, 64, out), 0 - 1, "negative counter refused");
    return 0;
}

fn test_audit_ring_view_exact() {
    test_group("audit: ring keeps exactly AUDIT_MAX_EVENTS across a trim");
    var a = audit_logger_new();
    var c = _mk_audit_call("agent-1", "tarang_probe");
    var total = AUDIT_MAX_EVENTS + AUDIT_TRIM_SLACK + 7;
    var i = 0;
    while (i < total) { audit_log(a, c, verdict_allow()); i = i + 1; }
    assert_eq(audit_total_count(a), AUDIT_MAX_EVENTS, "count capped");
    var r = audit_recent(a, 1);
    assert_eq(security_event_id(vec_get(r, 0)), total - 1, "newest kept");
    var all = audit_recent(a, total);
    assert_eq(vec_len(all), AUDIT_MAX_EVENTS, "recent sees the cap");
    assert_eq(security_event_id(vec_get(all, AUDIT_MAX_EVENTS - 1)), total - AUDIT_MAX_EVENTS, "oldest visible is the cap-th newest");
    return 0;
}

fn test_sighup_bad_fd() {
    test_group("signal: a bad descriptor is an error, not \"no signal\"");
    var t = tron_new(tron_config_default());
    assert_eq(sighup_drain_and_reload(0 - 1, t), TRON_ERR_IO, "fd -1 -> IO error");
    return 0;
}

fn main() {
    alloc_init();
    test_tron_load_policy_file();
    test_tron_reload_policy_noop();
    test_tron_reload_policy_picks_up_changes();
    test_sighup_init_returns_fd();
    test_sighup_triggers_reload();
    test_chacha20_rfc_vector();
    test_audit_export_json_shape();
    test_audit_export_encrypted_roundtrip();
    test_audit_decrypt_rejects_tamper();
    test_audit_decrypt_rejects_wrong_key();
    test_signed_reload_reverifies();
    test_signed_mode_refuses_unsigned_loads();
    test_signing_overlong_sig_rejected();
    test_export_draws_its_own_nonce();
    test_export_fails_on_bad_signing_key();
    test_export_escapes_and_sizes();
    test_audit_details_long_names();
    test_chacha20_counter_guard();
    test_audit_ring_view_exact();
    test_sighup_bad_fd();
    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
