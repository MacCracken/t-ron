# t-ron — MCP security monitor: the binary's entry point.
#
# Consumers take dist/t-ron.cyr (see DEPS-PATTERN.md), not this file.
# `cyrius build` prepends cyrius.cyml's deps in manifest order; these
# includes give the same order to a build without them. cyrius is
# single-pass, so each include must follow everything it references.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/slice.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/args.cyr"
include "lib/tagged.cyr"
include "lib/assert.cyr"
include "lib/fnptr.cyr"
include "lib/hashmap.cyr"
include "lib/regex.cyr"
include "lib/chrono.cyr"
include "lib/freelist.cyr"
include "lib/sakshi.cyr"
# bayan: json / base64 / bigint / u128. t-ron's src/ calls none of it;
# libro's canonical-JSON hashing does.
include "lib/bayan.cyr"
include "lib/net.cyr"
# atomic / thread / thread_local before sigil: its hash path takes a
# per-thread scratch bank (`cbank()` -> `thread_local_get`), and its batch
# verify spawns threads; `thread` builds on `atomic`. Without them the
# SHA-256 in libro's `chain_append` traps with SIGILL at run time.
include "lib/atomic.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"
# ct / keccak / random before sigil: its ML-DSA surface calls
# ct_eq_bytes_lens, ct_select, shake256 and random_bytes.
include "lib/ct.cyr"
include "lib/keccak.cyr"
include "lib/random.cyr"
# process before sigil: sigil's agnosys helpers call exec_capture.
include "lib/process.cyr"
# sigil, the full dist/sigil.cyr bundle (cyrius.cyml deps.sigil): only it
# carries the verify_data() src/signing.cyr calls.
include "lib/sigil.cyr"

include "lib/libro.cyr"

# bote's transport-free core profile (cyrius.cyml deps.bote-core).
include "lib/bote-core.cyr"

include "src/error.cyr"
include "src/json_text.cyr"
include "src/gate.cyr"
include "src/policy.cyr"
include "src/rate.cyr"
include "src/scanner.cyr"
include "src/pattern.cyr"
include "src/audit.cyr"
include "src/score.cyr"
include "src/query.cyr"
include "src/correlation.cyr"
include "src/tron.cyr"
include "src/tools.cyr"
include "src/middleware.cyr"
include "src/llm_scan.cyr"
include "src/signing.cyr"
include "src/signal.cyr"
include "src/crypto_chacha20.cyr"
include "src/safety.cyr"

fn main() {
    alloc_init();
    println("t-ron ready");
    return 0;
}

fn _entry(): i64 { var r = main(); sys_exit(r); return 0; }
_entry();
