#  correlation.cyr  --  cross-agent coordinated-access detector
#
#  Ported from rust-old/src/correlation.rs.
#
#  Flags when N distinct agents call the same tool within a time
#  window. Per-tool state is a vec of (agent_id, timestamp_secs).
#  Expired entries are pruned in place on each record.

var CORR_DEFAULT_WINDOW_SECS = 60;
var CORR_DEFAULT_THRESHOLD   = 3;

#  ============================================================
#  Call-record layout (16 bytes):
#    +0  agent_id cstring  (interned: owned by the detector)
#    +8  ts_secs  i64
#  ============================================================

fn _corr_rec_agent(r) { return load64(r); }
fn _corr_rec_ts(r)    { return load64(r + 8); }

#  ============================================================
#  CorrelationDetector (40 bytes):
#    +0   recent_calls  hashmap<tool_name cstring, vec<record ptr>>
#    +8   window_secs   i64
#    +16  threshold     i64
#    +24  names         hashmap<cstring, owned cstring>  (intern table)
#    +32  seen          vec, scratch for the distinct-agent count
#  ============================================================
#
#  Tool-name keys and record agent ids are owned copies from the intern
#  table: the caller's strings may be freed or reused once
#  correlation_record_and_check returns. One copy per distinct string, so
#  two records name the same agent exactly when their pointers are equal.
#  Bucket values are never 0 (checked at creation), so one map_get
#  answers both "present?" and "which?".

fn correlation_detector_new() {
    return correlation_detector_with_config(CORR_DEFAULT_WINDOW_SECS, CORR_DEFAULT_THRESHOLD);
}

fn correlation_detector_with_config(window_secs, threshold) {
    var d = alloc(40);
    if (d == 0) { return 0; }
    store64(d,      map_new());
    store64(d + 8,  window_secs);
    store64(d + 16, threshold);
    store64(d + 24, map_new());
    store64(d + 32, vec_new());
    if (load64(d) == 0 || load64(d + 24) == 0 || load64(d + 32) == 0) { return 0; }
    return d;
}

fn correlation_window(d)    { return load64(d + 8); }
fn correlation_threshold(d) { return load64(d + 16); }

#  The detector's owned copy of `s`, made on first sight; 0 if the copy
#  cannot be allocated.
fn _corr_intern(d, s) {
    var names = load64(d + 24);
    var own = map_get(names, s);
    if (own != 0) { return own; }
    var n = strlen(s);
    own = alloc(n + 1);
    if (own == 0) { return 0; }
    memcpy(own, s, n);
    store8(own + n, 0);
    map_set(names, own, own);
    return own;
}

#  Record a call and return a reason cstring if the distinct-agent
#  threshold is met for this tool within the time window, else 0. If the
#  detector cannot allocate the state to record the call it says so as a
#  reason (fail closed) rather than reporting a clean window it never saw.
fn correlation_record_and_check(d, agent_id, tool_name, ts_secs) {
    var m = load64(d);
    var window = load64(d + 8);
    var threshold = load64(d + 16);
    var cutoff = ts_secs - window;

    var bucket = map_get(m, tool_name);
    if (bucket == 0) {
        var key = _corr_intern(d, tool_name);
        if (key == 0) { return "coordinated access: detector state unavailable"; }
        bucket = vec_new();
        if (bucket == 0) { return "coordinated access: detector state unavailable"; }
        map_set(m, key, bucket);
    }
    var agent = _corr_intern(d, agent_id);
    if (agent == 0) { return "coordinated access: detector state unavailable"; }

    #  Prune expired entries in place (keep ts >= cutoff, in order). The
    #  first expired record is reused for this call, so a bucket in steady
    #  state allocates nothing -- no new vec, no new record, per call.
    var n = vec_len(bucket);
    var w = 0;
    var spare = 0;
    var i = 0;
    while (i < n) {
        var r = vec_get(bucket, i);
        if (_corr_rec_ts(r) >= cutoff) {
            if (w != i) { vec_set(bucket, w, r); }
            w = w + 1;
        }
        elif (spare == 0) { spare = r; }
        i = i + 1;
    }
    vec_truncate(bucket, w);
    if (spare == 0) {
        spare = alloc(16);
        if (spare == 0) { return "coordinated access: detector state unavailable"; }
    }
    store64(spare,     agent);
    store64(spare + 8, ts_secs);
    vec_push(bucket, spare);

    var distinct = _corr_count_distinct_agents(d, bucket, threshold);
    if (distinct >= threshold) {
        return _corr_format_alert(tool_name, distinct, window);
    }
    return 0;
}

#  Distinct agents in `bucket`, counted up to `limit` and no further: the
#  caller asks whether the threshold is met, not by how much, so the cost
#  is O(len * limit) rather than O(len * distinct). Agent ids are
#  interned, so identity is pointer equality. The `seen` scratch vec is
#  reused across calls.
fn _corr_count_distinct_agents(d, bucket, limit) {
    var seen = load64(d + 32);
    vec_truncate(seen, 0);
    var n = vec_len(bucket);
    var i = 0;
    while (i < n && vec_len(seen) < limit) {
        var a = _corr_rec_agent(vec_get(bucket, i));
        var sn = vec_len(seen);
        var dup = 0;
        var j = 0;
        while (j < sn) {
            if (vec_get(seen, j) == a) { dup = 1; j = sn; }
            else { j = j + 1; }
        }
        if (dup == 0) { vec_push(seen, a); }
        i = i + 1;
    }
    return vec_len(seen);
}

#  Build "coordinated access: N distinct agents called 'TOOL' within Ws".
#  N is the count at which the threshold was met.
fn _corr_format_alert(tool_name, agent_count, window_secs) {
    var tlen = strlen(tool_name);
    var buf = alloc(tlen + 96);
    if (buf == 0) { return "coordinated access: distinct-agent threshold met"; }
    var off = _tron_put(buf, 0, "coordinated access: ");
    off = _tron_put_int(buf, off, agent_count);
    off = _tron_put(buf, off, " distinct agents called '");
    memcpy(buf + off, tool_name, tlen); off = off + tlen;
    off = _tron_put(buf, off, "' within ");
    off = _tron_put_int(buf, off, window_secs);
    off = _tron_put(buf, off, "s");
    store8(buf + off, 0);
    return buf;
}
