#  tools.cyr  --  t-ron's MCP tool definitions and handlers
#
#  Ported from rust-old/src/tools.rs. Four tools for the T.Ron personality
#  in SecureYeoman to query security state:
#
#    tron_status   overall security summary
#    tron_risk     per-agent risk score
#    tron_audit    recent audit events
#    tron_policy   reload policy from a TOML string
#
#  Bote handlers have the signature `fn(args_cstr, claims) -> result_cstr`.
#  Because there's no captured state on the handler, the TRon instance is
#  kept in a module-level global that `tools_bind(tron)` installs before the
#  dispatcher is invoked.

var _tools_tron = 0;

fn tools_bind(tron) {
    _tools_tron = tron;
    return 0;
}

#  ============================================================
#  Tool definitions for registry
#  ============================================================
#
#  Returns a vec of ToolDef pointers that callers register alongside
#  their application tools in a `ToolRegistry` before constructing the
#  bote Dispatcher.
#
#  Every name, schema type, property and required entry is a C string.
#  bote stores them raw, and from 3.4.8 `registry_register` refuses a
#  definition `registry_check_tool_def` rejects (a Str header is not "object").

fn tron_tool_defs() {
    var defs = vec_new();
    vec_push(defs, _tron_status_def());
    vec_push(defs, _tron_risk_def());
    vec_push(defs, _tron_audit_def());
    vec_push(defs, _tron_policy_def());
    return defs;
}

fn _tron_status_def() {
    return tool_def_new(
        "tron_status",
        "Get overall security status: total events, denials, and system health.",
        schema_new("object", vec_new(), vec_new()));
}

fn _tron_risk_def() {
    var props = vec_new();
    vec_push(props, schema_prop_new(
        "agent_id",
        "{\"type\":\"string\",\"description\":\"Agent to score\"}"));
    var required = vec_new();
    vec_push(required, "agent_id");
    return tool_def_new(
        "tron_risk",
        "Get risk score for an agent (0.0 = trusted, 1.0 = hostile). Requires agent_id.",
        schema_new("object", props, required));
}

fn _tron_audit_def() {
    var props = vec_new();
    vec_push(props, schema_prop_new(
        "agent_id",
        "{\"type\":\"string\",\"description\":\"Filter by agent\"}"));
    vec_push(props, schema_prop_new(
        "limit",
        "{\"type\":\"integer\",\"description\":\"Max events to return\",\"default\":20}"));
    return tool_def_new(
        "tron_audit",
        "Get recent security events. Optional agent_id filter and limit (default 20).",
        schema_new("object", props, vec_new()));
}

fn _tron_policy_def() {
    var props = vec_new();
    vec_push(props, schema_prop_new(
        "toml",
        "{\"type\":\"string\",\"description\":\"Policy TOML content\"}"));
    var required = vec_new();
    vec_push(required, "toml");
    return tool_def_new(
        "tron_policy",
        "Load or reload policy from a TOML string.",
        schema_new("object", props, required));
}

#  A result's `text` is a JSON document inside a JSON string: each handler
#  escapes interpolated values once into the document (src/json_text.cyr),
#  and this escapes the whole document once more into `text`.
#
#  Wrap `text` as a bote CallToolResult:
#  {"content":[{"type":"text","text":"<text, escaped>"}]}, plus
#  "isError":true for an error. 0 when `text` is 0 or the alloc fails.
fn _tron_result_text(text, is_error) {
    if (text == 0) { return 0; }
    var buf = alloc(_tron_json_esc_len(text) + 64);
    if (buf == 0) { return 0; }
    var off = _tron_put(buf, 0, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    off = _tron_json_esc_into(buf, off, text);
    off = _tron_put(buf, off, "\"}]");
    if (is_error == 1) { off = _tron_put(buf, off, ",\"isError\":true"); }
    off = _tron_put(buf, off, "}");
    store8(buf + off, 0);
    return buf;
}

#  ============================================================
#  Handlers
#  ============================================================
#
#  Handler ABI (bote 2.0+): fn h(args_cstr, claims) → result_cstr.
#  t-ron's introspection tools currently ignore `claims` — these
#  endpoints expose project-wide audit / risk / policy state, not
#  caller-private data. Gating `tron_audit` / `tron_policy` on caller
#  identity waits on the agnosticos claims schema (see the roadmap);
#  the param is plumbed through here so the ABI is correct now.

fn tron_status_handler(args, claims) {
    var audit = tron_audit(_tools_tron);
    var total   = query_total_events(audit);
    var denials = query_total_denials(audit);

    #  {"total_events":N,"total_denials":M,"status":"clean|active"}
    var buf = alloc(128);
    if (buf == 0) { return 0; }
    var off = _tron_put(buf, 0, "{\"total_events\":");
    off = _tron_put_int(buf, off, total);
    off = _tron_put(buf, off, ",\"total_denials\":");
    off = _tron_put_int(buf, off, denials);
    if (denials == 0) { off = _tron_put(buf, off, ",\"status\":\"clean\"}"); }
    else              { off = _tron_put(buf, off, ",\"status\":\"active\"}"); }
    store8(buf + off, 0);
    return _tron_result_text(buf, 0);
}

fn tron_risk_handler(args, claims) {
    var audit = tron_audit(_tools_tron);
    var agent_id = jsonx_get_str(args, "agent_id");
    if (agent_id == 0) { agent_id = ""; }
    var score_bp = query_agent_risk_score(audit, agent_id);

    #  {"agent_id":"...","risk_score_bp":N,"risk_level":"..."}
    var buf = alloc(_tron_json_esc_len(agent_id) + 96);
    if (buf == 0) { return 0; }
    var off = _tron_put(buf, 0, "{\"agent_id\":\"");
    off = _tron_json_esc_into(buf, off, agent_id);
    off = _tron_put(buf, off, "\",\"risk_score_bp\":");
    off = _tron_put_int(buf, off, score_bp);
    off = _tron_put(buf, off, ",\"risk_level\":\"");
    off = _tron_put(buf, off, _tron_risk_level(score_bp));
    off = _tron_put(buf, off, "\"}");
    store8(buf + off, 0);
    return _tron_result_text(buf, 0);
}

fn _tron_risk_level(score_bp) {
    if (score_bp >= 800) { return "critical"; }
    if (score_bp >= 500) { return "high"; }
    if (score_bp >= 200) { return "medium"; }
    return "low";
}

fn tron_audit_handler(args, claims) {
    #  `limit` defaults to 20, capped at 1000 as in Rust.
    var limit = 20;
    var limit_raw = jsonx_get_raw(args, "limit");
    if (limit_raw != 0) { limit = atoi(limit_raw); }
    if (limit < 1)      { limit = 1; }
    if (limit > 1000)   { limit = 1000; }

    var audit = tron_audit(_tools_tron);
    var agent_id = jsonx_get_str(args, "agent_id");
    var events = 0;
    if (agent_id != 0) { events = query_agent_audit(audit, agent_id, limit); }
    else               { events = query_recent_events(audit, limit); }

    return _tron_result_text(_tron_events_to_json(events), 0);
}

#  Emit a JSON array of events: [{"agent_id":"...","tool_name":"...","verdict":"allow|deny|flag"},...]
#  Sized in a first pass over the events; 0 when the alloc fails.
fn _tron_events_to_json(events) {
    var n = vec_len(events);
    var need = 8;
    var i = 0;
    while (i < n) {
        var e = vec_get(events, i);
        need = need + _tron_json_esc_len(security_event_agent_id(e))
                    + _tron_json_esc_len(security_event_tool_name(e)) + 64;
        i = i + 1;
    }
    var buf = alloc(need);
    if (buf == 0) { return 0; }
    var off = _tron_put(buf, 0, "[");
    i = 0;
    while (i < n) {
        if (i > 0) { off = _tron_put(buf, off, ","); }
        var ev = vec_get(events, i);
        off = _tron_put(buf, off, "{\"agent_id\":\"");
        off = _tron_json_esc_into(buf, off, security_event_agent_id(ev));
        off = _tron_put(buf, off, "\",\"tool_name\":\"");
        off = _tron_json_esc_into(buf, off, security_event_tool_name(ev));
        off = _tron_put(buf, off, "\",\"verdict\":\"");
        off = _tron_put(buf, off, verdict_kind_as_str(security_event_kind(ev)));
        off = _tron_put(buf, off, "\"}");
        i = i + 1;
    }
    off = _tron_put(buf, off, "]");
    store8(buf + off, 0);
    return buf;
}

fn tron_policy_handler(args, claims) {
    var toml_str = jsonx_get_str(args, "toml");
    if (toml_str == 0) { return _tron_result_text("policy error: missing toml argument", 1); }
    if (strlen(toml_str) == 0) { return _tron_result_text("policy error: empty toml argument", 1); }
    var rc = tron_load_policy(_tools_tron, toml_str);
    if (rc == TRON_ERR_SIGNATURE) { return _tron_result_text("policy error: this monitor loads only signed policy files", 1); }
    if (rc != TRON_ERR_NONE) { return _tron_result_text("policy error: parse failed", 1); }
    return _tron_result_text("policy reloaded successfully", 0);
}
